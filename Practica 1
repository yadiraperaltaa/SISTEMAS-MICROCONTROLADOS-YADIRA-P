#include <WiFi.h>
#include <ESP32Ping.h>

const char* ssid = "NOMBRE_DE_TU_WIFI";
const char* password = "CONTRASEÑA_DE_TU_WIFI";

void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println("Conectando al Wi-Fi...");
  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nWi-Fi conectado");
  Serial.print("Direccion IP: ");
  Serial.println(WiFi.localIP());

  Serial.println("Haciendo ping a Google...");

  IPAddress googleIP(8, 8, 8, 8);

  if (Ping.ping(googleIP, 4)) {
    Serial.println("Respuesta de Google: ping exitoso");
  } else {
    Serial.println("No hubo respuesta al ping");
  }
}

void loop() {
}
